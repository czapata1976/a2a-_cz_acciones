# Copia este archivo a .env y pega tu GOOGLE_API_KEY. El .env real no se versiona.
GOOGLE_API_KEY=
MODELO=gemini-3.5-flash-lite

# Servidor local que expone este agente por A2A (Agent2Agent).
# El assistant_id es un UUID que el servidor asigna al grafo: se obtiene con
#   POST /assistants/search {"graph_id": "agente_cz_A2A"}
# Puerto propio (2029) para poder correr junto a agente_czz (2025) sin colisiones.
A2A_CZZ_URL=http://127.0.0.1:2029
A2A_CZZ_GRAPH=agente_cz_A2A

# Opcional: URL publica del tunel de Cloudflare, para que otro agente lo invoque desde otra red.
# Se deja vacia para usar 127.0.0.1.
#   $env:A2A_CZ_A2A_URL = "https://<algo>.trycloudflare.com"
A2A_CZ_A2A_URL=

# ── Canales: Telegram y WhatsApp ─────────────────────────────────────────────
# Servicio local de canales: recibe el mensaje y lo pasa al COORDINADOR, que elige al agente.
# No habla con el agente ni guarda su clave. Escucha solo en loopback.
CANALES_HOST=127.0.0.1
CANALES_PORT=8100
# Opcional: si lo defines, la gestión del puente exige X-Canales-Token (o ?token= en el navegador).
CANALES_TOKEN=
# Tiempo máximo de una consulta (los canales esperan al coordinador y este al agente).
A2A_TIMEOUT=180

# Telegram: token de BotFather y secreto del webhook (viaja en X-Telegram-Bot-Api-Secret-Token).
TELEGRAM_TOKEN=
TELEGRAM_SECRET=
TELEGRAM_API_BASE=https://api.telegram.org
# api = envía por Telegram; log = imprime la respuesta en el log (pruebas sin enviar).
TELEGRAM_ENVIO=api

# WhatsApp: puente Node/Baileys en loopback. Requiere `npm install` y un secreto de 16+ caracteres.
WHATSAPP_HABILITADO=false
WHATSAPP_SECRET=
WHATSAPP_URL_INTERNA=http://127.0.0.1:18082
WHATSAPP_TIMEOUT=20
WHATSAPP_MAX_CARACTERES=3500
# true = el coordinador arranca el puente dentro de su propio proceso (asi corre en Heroku). En local
# el puente lo levanta scripts/servidor_canales.py, asi que aqui queda en false.
WHATSAPP_PUENTE=false
# true = guarda la sesion de WhatsApp en Postgres (tabla czz_wa_sesion) para sobrevivir a los
# reinicios del dyno. Solo tiene sentido junto con DATABASE_URL; en local se deja en false.
WHATSAPP_SESION_DURABLE=false
# Variables que consume directamente el puente Node.
WHATSAPP_ENABLE_CONNECTION=true
WHATSAPP_BACKEND_URL=http://127.0.0.1:8100/whatsapp/mensaje
WHATSAPP_INTERNAL_PORT=18082

# --- Chat web: autenticacion, equipo A2A y flujo (puerto 8110) ---
# El chat NO habla con el agente: entra por el coordinador, asi que necesita COORDINADOR_URL y
# COORDINADOR_CLAVE (mas abajo) y A2A_CZZ_GRAPH solo como nombre del agente que sintetiza el turno.
WEB_HOST=127.0.0.1
WEB_PORT=8110
WEB_USUARIO=
# Hash pbkdf2_sha256 de la clave. Se genera con:
#   .venv\Scripts\python.exe scripts\clave_web.py
WEB_CLAVE_HASH=
# Firma la cookie de sesion: 32 caracteres o mas, aleatorio (el mismo script lo genera).
WEB_SECRETO=
WEB_HORAS_SESION=8
# Base del chat (equipo, conversaciones y trazas). Si se deja vacia y hay DATABASE_URL, usa
# Postgres; sin las dos cosas, SQLite en web/.runtime/chat.db (ignorada por git).
WEB_DATOS=
# Postgres opcional. Heroku la entrega sola al conectar el addon; en un Postgres compartido el
# chat crea sus propias tablas con prefijo czz_ para no mezclarse con otros proyectos.
DATABASE_URL=

# --- Produccion A2A: agente protegido, coordinador y canal ---
# Clave del agente: la ficha y /salud son publicas; message/send la exige en X-Agente-Clave.
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(24))"
# SOLO la usa el coordinador (URLS_AGENTES). Los canales y el chat web no la tienen: el agente solo
# responde al coordinador.
AGENTE_CLAVE=
# true = publica /docs y /redoc del servidor A2A para probar `message/send` desde el navegador.
# En Heroku se controla a mano (heroku config:set AGENTE_DOCS=true -a agente-cz-acciones); el
# esquema /openapi.json se publica siempre.
AGENTE_DOCS=false
# Direccion publica de la ficha. Vacia = la de la peticion. En Heroku: https://<app>.herokuapp.com
URL_PUBLICA=
COORDINADOR_HOST=0.0.0.0
COORDINADOR_PORT=8120
# Clave del coordinador: protege POST /chat (cabecera X-Coordinador-Clave). La usan los canales y el
# chat web para entrar; el coordinador es el unico que conoce AGENTE_CLAVE.
COORDINADOR_CLAVE=
COORDINADOR_URL=http://127.0.0.1:8120
# Agentes del equipo. Acepta lista de URLs separadas por coma o JSON con la clave de cada agente:
#   URLS_AGENTES=https://agente-1.example.com,https://agente-2.example.com
#   URLS_AGENTES=[{"url": "https://agente-1.example.com", "clave": "clave-ficticia-1"}]
URLS_AGENTES=
TIMEOUT_AGENTE=60
# true = imprime en el log cada salto del supervisor (eleccion, consulta y cita).
SALTOS=true
