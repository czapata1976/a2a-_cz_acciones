meta {
  name: 15 · telegram sin secreto (debe fallar)
  type: http
  seq: 15
}

post {
  url: {{coordinador}}/telegram
  body: json
  auth: none
}

body:json {
  {
    "message": {
      "chat": { "id": 1 },
      "text": "hola"
    }
  }
}

assert {
  res.status: eq 401
}

docs {
  Resultado 8: el endpoint del canal exige `X-Telegram-Bot-Api-Secret-Token`.
}
