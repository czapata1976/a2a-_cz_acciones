meta {
  name: 14 · agente sin clave (debe fallar)
  type: http
  seq: 14
}

post {
  url: {{agente}}/a2a
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": "bruno-2",
    "method": "message/send",
    "params": {
      "message": {
        "role": "user",
        "messageId": "bruno-m2",
        "contextId": "22222222-2222-2222-2222-222222222222",
        "parts": [{ "kind": "text", "text": "hola" }]
      }
    }
  }
}

assert {
  res.status: eq 401
}

docs {
  Resultado 8: sin `X-Agente-Clave`, el agente rechaza el mensaje. La ficha y `/salud` siguen
  siendo públicas (pruebas 11 y 12).
}
