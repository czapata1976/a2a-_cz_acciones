meta {
  name: 03 · ale estado tributario (SII)
  type: http
  seq: 3
}

post {
  url: {{ale}}/a2a
  body: json
  auth: none
}

headers {
  X-API-Key: {{process.env.ALE_API_KEY}}
  Accept: application/json
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": "bruno-ale-1",
    "method": "SendMessage",
    "params": {
      "message": {
        "message_id": "bruno-ale-m1",
        "context_id": "{{ale_contexto}}",
        "role": "ROLE_USER",
        "parts": [{ "text": "¿Qué observaciones tiene en el SII el RUT 77.987.654-3?" }]
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.jsonrpc: eq 2.0
  res.body.result: isDefined
}

tests {
  test("respondió con texto del informe", function() {
    const cuerpo = res.getBody();
    expect(cuerpo.error).to.be.undefined;
    const texto = JSON.stringify(cuerpo.result);
    expect(texto.length).to.be.greaterThan(150);
  });

  test("cita el RUT o la fuente", function() {
    const texto = JSON.stringify(res.getBody().result);
    expect(texto).to.match(/77\.?987\.?654|SII|RUT/);
  });
}

docs {
  Prueba de conexión real, con un ejemplo de la propia ficha del agente.

  OJO: este servidor usa **A2A 1.0**, así que el método es `SendMessage` (no `message/send`), los
  campos van en snake_case y el rol es `ROLE_USER`. Su `/openapi.json` lo confirma; si mandas el
  formato viejo, la clave correcta no alcanza a salvarte (responde «method not found»).

  `context_id` es el hilo de memoria; el 04 lo reutiliza. Si todo va bien vuelve `result` con la
  respuesta; si la clave no sirve, `res.status` 401 con
  `{"detail":"Clave de acceso ausente o inválida."}`.
}
